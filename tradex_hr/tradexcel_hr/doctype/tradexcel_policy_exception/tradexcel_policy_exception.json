{
 "actions": [],
 "autoname": "TPE-.#####",
 "doctype": "DocType",
 "engine": "InnoDB",
 "field_order": ["exception_type", "rule_name", "company", "employee_category", "scope_section", "branch", "department", "designation", "employee", "include_child_scope", "min_tenure_months", "value_section", "field_name", "value", "salary_component", "component_action", "component_amount", "attendance_setting", "attendance_value", "tax_action", "holiday_list", "shift_type", "leave_type", "extra_days", "effective_from", "effective_to", "reason", "preview_section", "preview_summary", "preview_signature", "previewed_at", "enforcement_note", "applied_reference"],
 "fields": [
  {"fieldname": "exception_type", "fieldtype": "Select", "label": "Exception Type", "options": "Payroll\nComponent\nAttendance\nLeave\nHoliday\nShift\nTax", "default": "Payroll", "reqd": 1, "in_list_view": 1, "description": "One place for every policy exception. Each type shows only its own settings."},
  {"fieldname": "rule_name", "fieldtype": "Data", "label": "Rule Name", "reqd": 1, "in_list_view": 1},
  {"fieldname": "company", "fieldtype": "Link", "label": "Company", "options": "Company", "reqd": 1, "in_list_view": 1},
  {"fieldname": "employee_category", "fieldtype": "Select", "label": "Employee Category", "options": "Worker\nStaff", "default": "Worker", "depends_on": "eval:doc.exception_type==\"Payroll\"", "description": "Staff means every non daily-wage employee. Must match the selected employee's employment type."},
  {"fieldname": "scope_section", "fieldtype": "Section Break", "label": "Who This Applies To"},
  {"fieldname": "branch", "fieldtype": "Link", "label": "Branch", "options": "Branch"},
  {"fieldname": "department", "fieldtype": "Link", "label": "Department", "options": "Department"},
  {"fieldname": "designation", "fieldtype": "Link", "label": "Designation", "options": "Designation"},
  {"fieldname": "employee", "fieldtype": "Link", "label": "Employee", "options": "Employee", "description": "Optional for Payroll, Component and Attendance; required for Leave, Holiday, Shift and Tax."},
  {"fieldname": "include_child_scope", "fieldtype": "Check", "label": "Include Sub-Branches and Sub-Departments", "default": "1", "depends_on": "eval:doc.exception_type==\"Component\" || doc.exception_type==\"Attendance\"", "description": "Off: only the exact selection. On: the selection plus every child under it in the hierarchy (example: Tradexcel Headquarters also covers TCL Factory). The preview lists every covered node."},
  {"fieldname": "min_tenure_months", "fieldtype": "Int", "label": "Minimum Completed Service (Months)", "depends_on": "eval:doc.exception_type==\"Payroll\"", "description": "Optional eligibility condition based on joining date; not an automatic priority."},
  {"fieldname": "value_section", "fieldtype": "Section Break", "label": "Value and Effective Dates"},
  {"fieldname": "field_name", "fieldtype": "Select", "label": "Setting", "options": "daily_wage\nbreak_minutes\nstandard_hours_per_day\novertime_enabled\novertime_after_hours\novertime_grace_minutes\novertime_rounding_minutes\novertime_multiplier\nmax_daily_overtime_hours\nmax_weekly_hours", "in_list_view": 1, "depends_on": "eval:doc.exception_type==\"Payroll\""},
  {"fieldname": "value", "fieldtype": "Float", "label": "New Value", "depends_on": "eval:doc.exception_type==\"Payroll\""},
  {"fieldname": "salary_component", "fieldtype": "Link", "label": "Salary Component", "options": "Salary Component", "depends_on": "eval:doc.exception_type==\"Component\""},
  {"fieldname": "component_action", "fieldtype": "Select", "label": "Component Action", "options": "Exclude\nInclude\nOverride Amount", "depends_on": "eval:doc.exception_type==\"Component\""},
  {"fieldname": "component_amount", "fieldtype": "Float", "label": "Override Amount", "depends_on": "eval:doc.exception_type==\"Component\" && doc.component_action==\"Override Amount\""},
  {"fieldname": "attendance_setting", "fieldtype": "Select", "label": "Attendance Setting", "options": "Ignore Late Marking\nIgnore Early Exit\nIgnore Late and Early Exit\nLate Grace Minutes\nEarly Exit Grace Minutes", "depends_on": "eval:doc.exception_type==\"Attendance\"", "description": "Ignore clears the flag; grace settings recompute the flag from the linked shift timing."},
  {"fieldname": "attendance_value", "fieldtype": "Float", "label": "Attendance Value (Minutes)", "depends_on": "eval:doc.exception_type==\"Attendance\" && (doc.attendance_setting||'').indexOf('Minutes')>=0", "description": "Minutes of grace for the chosen setting."},
  {"fieldname": "tax_action", "fieldtype": "Select", "label": "Tax Action", "options": "Mark Tax Exempt", "depends_on": "eval:doc.exception_type==\"Tax\"", "description": "Removes income-tax deduction components on this employee's salary slips."},
  {"fieldname": "holiday_list", "fieldtype": "Link", "label": "Holiday List", "options": "Holiday List", "depends_on": "eval:doc.exception_type==\"Holiday\""},
  {"fieldname": "shift_type", "fieldtype": "Link", "label": "Shift Type", "options": "Shift Type", "depends_on": "eval:doc.exception_type==\"Shift\""},
  {"fieldname": "leave_type", "fieldtype": "Link", "label": "Leave Type", "options": "Leave Type", "depends_on": "eval:doc.exception_type==\"Leave\""},
  {"fieldname": "extra_days", "fieldtype": "Float", "label": "Extra Days", "depends_on": "eval:doc.exception_type==\"Leave\""},
  {"fieldname": "effective_from", "fieldtype": "Date", "label": "Effective From", "in_list_view": 1, "description": "Defaults to tomorrow. Past dates require preview and reconciliation."},
  {"fieldname": "effective_to", "fieldtype": "Date", "label": "Effective To"},
  {"fieldname": "reason", "fieldtype": "Small Text", "label": "Business Reason", "reqd": 1},
  {"fieldname": "preview_section", "fieldtype": "Section Break", "label": "Impact Preview", "depends_on": "eval:doc.exception_type==\"Payroll\" || doc.exception_type==\"Component\" || doc.exception_type==\"Attendance\""},
  {"fieldname": "preview_summary", "fieldtype": "Small Text", "label": "Preview Summary", "read_only": 1, "depends_on": "eval:doc.exception_type==\"Payroll\" || doc.exception_type==\"Component\" || doc.exception_type==\"Attendance\""},
  {"fieldname": "preview_signature", "fieldtype": "Data", "label": "Preview Signature", "hidden": 1, "read_only": 1},
  {"fieldname": "previewed_at", "fieldtype": "Datetime", "label": "Previewed At", "read_only": 1, "depends_on": "eval:doc.exception_type==\"Payroll\" || doc.exception_type==\"Component\" || doc.exception_type==\"Attendance\""},
  {"fieldname": "enforcement_note", "fieldtype": "Data", "label": "Enforcement", "read_only": 1},
  {"fieldname": "applied_reference", "fieldtype": "Data", "label": "Applied Record", "hidden": 1, "read_only": 1}
 ],
 "is_submittable": 1,
 "module": "Tradexcel HR",
 "name": "Tradexcel Policy Exception",
 "permissions": [
  {"role": "System Manager", "read": 1, "write": 1, "create": 1, "submit": 1, "cancel": 1, "export": 1, "print": 1, "report": 1},
  {"role": "HR Manager", "read": 1, "write": 1, "create": 1, "export": 1, "print": 1, "report": 1},
  {"role": "Tradexcel Payroll Manager", "read": 1, "write": 1, "create": 1, "export": 1, "print": 1, "report": 1},
  {"role": "Tradexcel Payroll Approver", "read": 1, "write": 1, "submit": 1, "cancel": 1, "export": 1, "print": 1, "report": 1},
  {"role": "HR User", "read": 1}
 ],
 "sort_field": "modified",
 "sort_order": "DESC",
 "track_changes": 1
}
