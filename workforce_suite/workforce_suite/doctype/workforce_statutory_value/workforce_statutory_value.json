{
 "doctype": "DocType",
 "module": "Workforce Suite",
 "engine": "InnoDB",
 "track_changes": 0,
 "allow_rename": 0,
 "name": "Workforce Statutory Value",
 "istable": 1,
 "editable_grid": 1,
 "field_order": [
  "field_key",
  "row_number",
  "field_value",
  "field_label",
  "value_status",
  "source_reference",
  "applicability_note"
 ],
 "fields": [
  {
   "fieldname": "field_key",
   "fieldtype": "Data",
   "label": "Field Key",
   "reqd": 1,
   "in_list_view": 1
  },
  {
   "fieldname": "field_value",
   "fieldtype": "Small Text",
   "label": "Value",
   "reqd": 0,
   "in_list_view": 1
  },
  {
   "fieldname": "field_label",
   "fieldtype": "Data",
   "label": "Prescribed Field",
   "read_only": 1,
   "in_list_view": 1
  },
  {
   "fieldname": "value_status",
   "fieldtype": "Select",
   "label": "Evidence State",
   "options": "Unresolved\nEvidence Entered\nNot Applicable",
   "default": "Unresolved",
   "in_list_view": 1
  },
  {
   "fieldname": "source_reference",
   "fieldtype": "Small Text",
   "label": "Source / Calculation Provenance"
  },
  {
   "fieldname": "applicability_note",
   "fieldtype": "Small Text",
   "label": "Reviewed Non-applicability Reason"
  },
  {
   "fieldname": "row_number",
   "fieldtype": "Int",
   "label": "History / Table Row",
   "default": 0,
   "description": "0 for single facts. Positive row number groups repeatable prescribed table cells."
  }
 ]
}
