{
 "doctype": "DocType",
 "module": "Workforce Suite",
 "engine": "InnoDB",
 "track_changes": 1,
 "allow_rename": 0,
 "name": "Workforce Statutory Print Layout",
 "autoname": "naming_series:",
 "naming_series": "WSPL-.YYYY.-.#####",
 "is_submittable": 1,
 "sort_field": "modified",
 "sort_order": "DESC",
 "field_order": [
  "naming_series",
  "title",
  "company",
  "branch",
  "form_code",
  "form_family",
  "data_source",
  "layout_style",
  "orientation",
  "template_version",
  "effective_from",
  "effective_to",
  "source_url",
  "source_sha256",
  "legal_review_reference",
  "legal_review_notes",
  "title_bn",
  "title_en",
  "header_note",
  "footer_note",
  "columns",
  "approved_by",
  "approved_at",
  "statutory_profile",
  "header_note_bn",
  "footer_note_bn",
  "salary_mappings"
 ],
 "fields": [
  {
   "fieldname": "naming_series",
   "fieldtype": "Select",
   "label": "Series",
   "options": "WSPL-.YYYY.-.#####",
   "default": "WSPL-.YYYY.-.#####",
   "reqd": 1
  },
  {
   "fieldname": "title",
   "fieldtype": "Data",
   "label": "Layout Title",
   "reqd": 1,
   "in_list_view": 1
  },
  {
   "fieldname": "company",
   "fieldtype": "Link",
   "options": "Company",
   "label": "Company",
   "reqd": 1,
   "in_list_view": 1
  },
  {
   "fieldname": "branch",
   "fieldtype": "Link",
   "options": "Branch",
   "label": "Establishment / Branch"
  },
  {
   "fieldname": "form_code",
   "fieldtype": "Select",
   "options": "appointment_letter_sample\nform_6\nform_6a\nform_7\nform_8\nform_9\nform_19\nform_20\nform_22\nform_22a\nform_23\nform_24\nform_25a\nform_26\nform_26a\nform_27\nform_28\nform_32\nform_33\nform_34\nform_35_35a\nform_36\nform_37_37a_37b\nform_38\nform_39\nform_80\nform_81\nschedule_7\nrule_353",
   "label": "DIFE Source Entry",
   "reqd": 1,
   "in_list_view": 1
  },
  {
   "fieldname": "form_family",
   "fieldtype": "Select",
   "options": "Register\nDocument\nReturn\nEvidence Only",
   "label": "Document Style",
   "reqd": 1,
   "description": "Source type; official registration/certificate documents cannot be generated by this app."
  },
  {
   "fieldname": "data_source",
   "fieldtype": "Select",
   "options": "Manual\nEmployee\nAttendance\nLeave Application\nSalary Slip",
   "label": "Data Source",
   "reqd": 1,
   "description": "Manual records require evidence entered in Workforce Statutory Record. Native sources are permission-scoped; absent fields remain blank."
  },
  {
   "fieldname": "layout_style",
   "fieldtype": "Select",
   "options": "Minimal Black and White",
   "label": "Print Style",
   "default": "Minimal Black and White",
   "reqd": 1
  },
  {
   "fieldname": "orientation",
   "fieldtype": "Select",
   "options": "Portrait\nLandscape",
   "label": "A4 Orientation",
   "reqd": 1,
   "in_list_view": 1
  },
  {
   "fieldname": "template_version",
   "fieldtype": "Data",
   "label": "Template Version",
   "reqd": 1,
   "default": "draft-1"
  },
  {
   "fieldname": "effective_from",
   "fieldtype": "Date",
   "label": "Effective From",
   "reqd": 1
  },
  {
   "fieldname": "effective_to",
   "fieldtype": "Date",
   "label": "Effective To"
  },
  {
   "fieldname": "source_url",
   "fieldtype": "Data",
   "label": "Government PDF Source URL",
   "read_only": 1,
   "length": 512
  },
  {
   "fieldname": "source_sha256",
   "fieldtype": "Data",
   "label": "Government PDF SHA-256",
   "read_only": 1
  },
  {
   "fieldname": "legal_review_reference",
   "fieldtype": "Data",
   "label": "Legal Review / Gazette Reference"
  },
  {
   "fieldname": "legal_review_notes",
   "fieldtype": "Small Text",
   "label": "Legal Review Notes (never printed)",
   "description": "Government instructions are not displayed in the company print PDF."
  },
  {
   "fieldname": "title_bn",
   "fieldtype": "Data",
   "label": "Bengali Print Heading",
   "description": "Complete Bangla heading and labels are required; no English fallback."
  },
  {
   "fieldname": "title_en",
   "fieldtype": "Data",
   "label": "English Print Heading",
   "reqd": 1
  },
  {
   "fieldname": "header_note",
   "fieldtype": "Small Text",
   "label": "Optional Company Heading (printed)",
   "description": "Company-entered heading only, not source PDF directions."
  },
  {
   "fieldname": "footer_note",
   "fieldtype": "Small Text",
   "label": "Optional Signature / Footer (printed)",
   "description": "Company-entered signatory labels, not source PDF directions."
  },
  {
   "fieldname": "columns",
   "fieldtype": "Table",
   "label": "Editable Print Columns",
   "options": "Workforce Statutory Print Column",
   "reqd": 1
  },
  {
   "fieldname": "approved_by",
   "fieldtype": "Link",
   "options": "User",
   "label": "Approved By",
   "read_only": 1
  },
  {
   "fieldname": "approved_at",
   "fieldtype": "Datetime",
   "label": "Approved At",
   "read_only": 1
  },
  {
   "fieldname": "statutory_profile",
   "fieldtype": "Link",
   "label": "Reviewed Establishment Profile",
   "options": "Workforce Statutory Profile"
  },
  {
   "fieldname": "header_note_bn",
   "fieldtype": "Small Text",
   "label": "Company Heading (Bangla)"
  },
  {
   "fieldname": "footer_note_bn",
   "fieldtype": "Small Text",
   "label": "Signature / Footer (Bangla)"
  },
  {
   "fieldname": "salary_mappings",
   "fieldtype": "Table",
   "label": "Additional Earning Component Mappings",
   "options": "Workforce Statutory Component Mapping",
   "depends_on": "eval:doc.data_source == \"Salary Slip\"",
   "description": "Explicit print-only grouping of native earning components. Each component is counted exactly once; this does not configure pay."
  }
 ],
 "permissions": [
  {
   "role": "System Manager",
   "read": 1,
   "write": 1,
   "create": 1,
   "delete": 0,
   "submit": 1,
   "cancel": 0,
   "print": 1,
   "export": 1
  },
  {
   "role": "Workforce Compliance Auditor",
   "read": 1,
   "write": 1,
   "create": 1,
   "delete": 0,
   "submit": 1,
   "cancel": 0,
   "print": 1,
   "export": 1
  }
 ]
}
