  {"fieldname":"fixed_area_amount","fieldtype":"Currency","label":"Fixed Area Amount","default":"0"},
  {"fieldname":"allowance_multiplier","fieldtype":"Float","label":"Allowance Multiplier","default":"1"},
  {"fieldname":"max_km_per_day","fieldtype":"Float","label":"Maximum Km per Day"},
  {"fieldname":"allowance_salary_component","fieldtype":"Link","label":"Allowance Salary Component","options":"Salary Component","default":"Field Transport Allowance","depends_on":"eval:doc.allowance_mode!='None'"},
  {"fieldname":"allowance_requires_approval","fieldtype":"Check","label":"Require Allowance Approval","default":"0"},
  {"fieldname":"notes","fieldtype":"Small Text","label":"Notes"}
